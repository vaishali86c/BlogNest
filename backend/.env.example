# ---- Server ----
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# ---- Database ----
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/blognest

# ---- Auth / JWT ----
# Long random string. Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Origin of the frontend (Vite dev server default is http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ---- Google OAuth ----
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ---- Cloudinary (banner uploads) ----
# Get from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
